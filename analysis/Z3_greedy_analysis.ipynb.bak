   "source": [
    "## Helpers (physics + plotting)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "d72aeb0c",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-06-28T11:23:34.389720Z",
     "iopub.status.busy": "2026-06-28T11:23:34.389459Z",
     "iopub.status.idle": "2026-06-28T11:23:34.469992Z",
     "shell.execute_reply": "2026-06-28T11:23:34.468956Z"
    }
   },
   "outputs": [
