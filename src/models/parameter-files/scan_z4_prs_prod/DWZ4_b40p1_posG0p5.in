#Output
outputfile = /mt/user-batch/dpasari/scan_z4_prs_prod/results_DWZ4_b40p1_posG0p5/

#Evolution
expansion = true
evolver = LF

#Lattice
N = 512
dt = 0.01
lSide = 100.0     # dx=0.1953; delta_min(b4=0.1)=1.40 -> 7.2 pts/wall@a=1 (strict 1pt to a~7.2; see note)

#Times
t0 = 0
tOutputFreq  = 0.1
tOutputInfreq  = 5
tOutputRareFreq = 3
tMax = 50.0     # a=1+eta -> a_max~51; comoving horizon~a hits L at a~100 (finite-volume)

#Spectra options
PS_type = 1
PS_version = 1

#GWs
GWprojectorType = 2
withGWs = false

fixedBackground = true
omegaEoS = 0.3333
H0 = 0.10000000   # 1.0*mu (H0/mu=1)

#IC
kCutOff = 3
initial_amplitudes = 0 0
initial_momenta    = 0 0

# energy_snapshot = E_S_G 

# Z4 domain-wall, NEW beta4 = 2*lambda2/lambda1 = 0.1, v=1, mu=0.1
# lambda1 = mu^2/(1-b4), lambda2 = b4*mu^2/(2(1-b4))  (v=mu/sqrt(lambda1-2lambda2)=1)
mu      = 0.1
lambda1 = 0.01111111111
lambda2 = 0.0005555555556

# ---- POSITIVE friction, POST-FORMATION (user design): Gamma=+0.5 switched ON at
# frictionStartA=8 (~just above a_break=7-8; REFINE to just above the measured a_break from
# DWZ4_b40p1_std), OFF at frictionEndA=70 (>a_max=51 => on for the whole post-formation run).
# Goal: damp the post-formation ringing so the network settles onto the SCALING attractor
# faster (the legitimate use of +Gamma). Positive Gamma is UNCONDITIONALLY stable -- no 2H
# constraint, unlike the negative PRE-formation cards. NEEDS the frictionStartA gate (binary
# rebuilt 2026-06-04). Must switch while the network is FORMED and still ~resolved (pts/wall>~1).
# Gamma=0.5/1.0/2.0 brackets under-/near-critical/over-damping (~2m_eff); heavy Gamma over-damps
# and can SLOW coarsening -- compare the approach-to-plateau across the three. ----
prsWall       = false
prsDamping    = 0.0
frictionGamma = 0.5
frictionStartA= 8
frictionEndA  = 70
prsStartA     = 0.0

