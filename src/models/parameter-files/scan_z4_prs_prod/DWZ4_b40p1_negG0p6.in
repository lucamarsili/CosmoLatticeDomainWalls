#Output
outputfile = /mt/user-batch/dpasari/scan_z4_prs_prod/results_DWZ4_b40p1_negG0p6/

#Evolution
expansion = true
evolver = LF

#Lattice
N = 512
dt = 0.01
lSide = 100.0     # dx=0.1953; delta_min(b4=0.1)=1.40 -> 7.2 pts/wall@a=1 (strict 1pt to a~7.2; see note)

#Times
t0 = 0
tOutputFreq  = 0.1
tOutputInfreq  = 5
tOutputRareFreq = 3
tMax = 50.0     # a=1+eta -> a_max~51; comoving horizon~a hits L at a~100 (finite-volume)

#Spectra options
PS_type = 1
PS_version = 1

#GWs
GWprojectorType = 2
withGWs = false

fixedBackground = true
omegaEoS = 0.3333
H0 = 0.10000000   # 1.0*mu (H0/mu=1)

#IC
kCutOff = 3
initial_amplitudes = 0 0
initial_momenta    = 0 0

# energy_snapshot = E_S_G 

# Z4 domain-wall, NEW beta4 = 2*lambda2/lambda1 = 0.1, v=1, mu=0.1
# lambda1 = mu^2/(1-b4), lambda2 = b4*mu^2/(2(1-b4))  (v=mu/sqrt(lambda1-2lambda2)=1)
mu      = 0.1
lambda1 = 0.01111111111
lambda2 = 0.0005555555556

# ---- NEGATIVE-FRICTION experiment (user): Gamma=-0.6 from a=1, OFF at frictionEndA=2.2.
# Net EOM friction = 2H+Gamma (2H=2/a); stays POSITIVE (no anti-damped blow-up) while
# a<2/|Gamma|=3.3, so frictionEndA is safely below. Less drag -> faster early roll-off ->
# earlier formation? Compare a_break vs DWZ4_b40p1_std (which forms ~a=7-8). (Gamma=-0.15 has
# the longest/most-relevant window.) ----
prsWall       = false
prsDamping    = 0.0
frictionGamma = -0.6
frictionStartA= 0.0
frictionEndA  = 2.2
prsStartA     = 0.0

