#Output
outputfile = /mt/user-batch/dpasari/scan_z4_beta4/results_z4_mu0p01_beta40p75_H1mu_k3/

#Evolution
expansion = true
evolver = LF

#Lattice
N = 512
dt = 0.01
lSide = 100

#Times
t0 = 0
tOutputFreq  = 0.1
tOutputInfreq  = 5
tOutputRareFreq = 3
tMax = 90

#Spectra options
PS_type = 1
PS_version = 1

#GWs
GWprojectorType = 2
withGWs = false

fixedBackground = true
omegaEoS = 0.3333
H0 = 0.01000000   # 1.0000 * mu = 1.0000 * 0.01

#IC
kCutOff = 3
initial_amplitudes = 0 0
initial_momenta    = 0 0

# Model Parameters  (Z4 domain-wall model, new parameterization)
# V = -mu^2 |Phi|^2 + lambda1 |Phi|^4 - lambda2 (Phi^4 + Phi*^4)
# Vacuum vev:  v = mu / sqrt(lambda1 - 2*lambda2) = 1  (unit vev)
# Constraint:  lambda1 = mu^2 + 2*lambda2
# Z4 strength: beta_4 = 2*lambda2/lambda1 = 0.7500  (in (0,1))
# Check:  lambda1 - 2*lambda2 = mu^2 = 1.00e-04  (must equal mu^2 for v=1)
mu      = 0.01
lambda1 = 0.0004000000
lambda2 = 0.0001500000
