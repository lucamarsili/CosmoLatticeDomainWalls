#Output
outputfile = /mt/user-batch/dpasari/scan_z4_prs_long/results_DWZ4_long_b40p3/

#Evolution
expansion = true
evolver = LF

#Lattice
N = 1024
dt = 0.02
lSide = 358.4     # dx=0.3500; frozen walls: adj 4.2 cells, opp 4.0 cells (PRS widths delta_bar/mu)

#Times
t0 = 0
tOutputFreq  = 0.1
tOutputInfreq  = 5
tOutputRareFreq = 3
tMax = 150.0     # a=1+eta; box = mu*L/(1+eta) horizons/side: 3.55 @eta=100, 2.37 @eta=150

#Spectra options
PS_type = 1
PS_version = 1

#GWs
GWprojectorType = 2
withGWs = false

fixedBackground = true
omegaEoS = 0.3333
H0 = 1.00000000   # = mu (H0/mu=1 -> a=1+eta)

#IC
kCutOff = 3
initial_amplitudes = 0 0
initial_momenta    = 0 0

# Z4 domain-wall, beta4 = 2*lambda2/lambda1 = 0.3, v=1, mu=1.0
# lambda1 = mu^2/(1-b4), lambda2 = b4*mu^2/(2(1-b4))  (v=mu/sqrt(lambda1-2lambda2)=1)
mu      = 1.0
lambda1 = 1.428571429
lambda2 = 0.2142857143

# ---- LONG-eta PRS scan (2026-06-10): opposite-wall scaling across the beta4=1/3
# stability transition (sigma_opp = 2*sigma_adj exactly at beta4=1/3: opposite walls
# unstable to splitting for beta4<1/3, bound for beta4>1/3).
# Sizing (BVP widths: delta_adj(0.3)=1.46 -> 4.2 cells, delta_opp=1.40 -> 4.0 cells):
#   IR:  mu*L = 358 >> 2pi  (~97,176 tachyonic modes)
#   UV:  thinnest wall >= 4.0 cells (validated window needs ~4; see hires cross-check)
#   Vol: 2.37 horizons/side at eta=150
# Success: Ev1<0 and <|Phi|^2> -> 0.5 and STAYS; watch mean-field drift (finite volume). ----
prsWall       = true
prsDamping    = 1.0
frictionGamma = 0.0
frictionStartA= 0.0
frictionEndA  = 0.0
prsStartA     = 0
