#Output
outputfile = /mt/user-batch/dpasari/scan_z4_phys_ext/results_DWZ4_physstat_b40p98_s02/

#Evolution
expansion = true
evolver = LF

#Lattice
N = 512
dt = 0.00569
lSide = 130.32     # mu=0.07: cells/wall = delta_bar/(mu*a*dx); sized so >=1 cell at a_max, >=2 horizons

#Times
t0 = 0
tOutputFreq  = 0.1
tOutputInfreq  = 5
tOutputRareFreq = 3
tMax = 64.16      # a=1+eta; a_max=65.2

#Spectra options
PS_type = 1
PS_version = 1

#GWs
GWprojectorType = 2
withGWs = false

fixedBackground = true
omegaEoS = 0.3333
H0 = 0.07          # H0/mu = 1 -> a = 1+eta

#IC
kCutOff = 3
baseSeed = stat_s02
initial_amplitudes = 0 0
initial_momenta    = 0 0

# Z4 domain wall, beta4 = 2*lambda2/lambda1 = 0.98; lambda1-2lambda2 = 1 (kick = sqrt(l1-2l2) = 1)
mu      = 0.07
lambda1 = 50.0000000000
lambda2 = 24.5000000000

# EXTREME-beta extension (2026-06-24) of scan_z4_phys_stat. A=scal/(2aH).
prsWall = false
