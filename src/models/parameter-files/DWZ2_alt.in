outputfile = /mt/user-batch/dpasari/results_z3_b0/

#Evolution
expansion = true
evolver = LF
#Lattice
N = 256
dt = 0.01
lSide = 12

#Times
t0=0
tOutputFreq = 0.1
tOutputInfreq = 1
tOutputRareFreq = 1
tMax = 30

# energy_snapshot = S_C E_S_K E_S_G E_V


#Spectra options
PS_type = 1
PS_version = 1

#GW
GWprojectorType = 2
withGWs = false
spectraverbosity=2
print_header = true

fixedBackground = true
omegaEoS = 0.333

#IC
kCutOff = 1
initial_amplitudes = 0     # homogeneous amplitudes in GeV
initial_momenta = 0     # homogeneous amplitudes in GeV2

#Model Parameters
lambda = 0.003
eta = 0.0547723

H0 = 0.0547723 #GeV sqrt(2)*mu
