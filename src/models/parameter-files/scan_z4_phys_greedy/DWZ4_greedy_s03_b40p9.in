#Output
outputfile = results/scan_z4_phys_greedy/results_DWZ4_greedy_b40p9_s03/

#Evolution
expansion = true
evolver = LF

#Lattice
N = 1024
dt = 0.006157
lSide = 126.10     # mu=0.07: cells/wall = delta_adj/(mu*a*dx); =2 at a_max (>=2 horizons/side)

#Times
t0 = 0
tOutputFreq  = 0.1
tOutputInfreq  = 5
tOutputRareFreq = 3
tMax = 62.05      # a=1+eta; a_max=63.1
tBackupFreq = -1.00     # <0 = OFF (default); runs fit <72h at rec. ranks. BACKUP_FRAC to enable.

#Spectra options
PS_type = 1
PS_version = 1

#GWs
GWprojectorType = 2
withGWs = false

fixedBackground = true
omegaEoS = 0.3333
H0 = 0.07          # H0/mu = 1 -> a = 1+eta

#IC
kCutOff = 3
baseSeed = greedy_s03
initial_amplitudes = 0 0
initial_momenta    = 0 0

# Z4 domain wall, beta4 = 2*lambda2/lambda1 = 0.9; lambda1-2lambda2 = 1 (kick = 1)
mu      = 0.07
lambda1 = 10.0000000000
lambda2 = 4.5000000000

# GREEDY N=1024 plateau scan (2026-06-26). PHYSICAL. A=scal/(2aH); wall_diagnostics emitted.
prsWall = false
