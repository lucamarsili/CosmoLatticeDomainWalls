#Output
outputfile = /mt/user-batch/dpasari/scan_z3_phys_ext/results_DWZ3_physstat_b30p95_s03/

#Evolution
expansion = true
evolver = LF

#Lattice
N = 512
dt = 0.01013
lSide = 103.69     # mu=0.07: cells/wall = delta_bar/(mu*a*dx); sized so >=1 cell at a_max, >=2 horizons

#Times
t0 = 0
tOutputFreq  = 0.1
tOutputInfreq  = 5
tOutputRareFreq = 3
tMax = 50.85      # a=1+eta; a_max=51.8

#Spectra options
PS_type = 1
PS_version = 1

#GWs
GWprojectorType = 2
withGWs = false

fixedBackground = true
omegaEoS = 0.3333
H0 = 0.07          # H0/mu = 1 -> a = 1+eta

#IC
kCutOff = 3
baseSeed = stat_s03
initial_amplitudes = 0 0
initial_momenta    = 0 0

# Z3 domain wall, beta_N = 0.95 (R=sqrt((1-bN)/(1+bN))), lambda1=1/R, lambda2=sqrt(2)(1-R)/(3R)
mu      = 0.07
lambda1 = 6.2449979984
lambda2 = 2.4725157680

# EXTREME-beta extension (2026-06-24) of scan_z3_phys_stat. A=scal/(2aH); scal1=last col.
prsWall = false
