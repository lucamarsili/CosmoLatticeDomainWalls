#Output
outputfile = /mt/user-batch/dpasari/scan_z4/results_z4_mu0p1_beta2_H1mu_k1/

#Evolution
expansion = true
evolver = LF

#Lattice
N = 512
dt = 0.01
lSide = 100

#Times
t0 = 0
tOutputFreq  = 0.1
tOutputInfreq  = 5
tOutputRareFreq = 3
tMax = 50

#Spectra options
PS_type = 1
PS_version = 1

#GWs
GWprojectorType = 2
withGWs = false

fixedBackground = true
omegaEoS = 0.3333
H0 = 0.10000000   # 1.0000 * mu = 1.0000 * 0.1

#IC
kCutOff = 1
initial_amplitudes = 0 0
initial_momenta    = 0 0

# Model Parameters  (Z4 domain-wall model)
# Vacuum vev:  v = mu / sqrt(lambda1 - 2*mu*lambda2) = 1  (unit vev)
# Constraint:  lambda1 = mu^2 + 2*mu*lambda2
# Z4 strength: beta = 3*lambda2/sqrt(8*lambda1) = 2.0000  (>0)
# Check:  lambda1 - 2*mu*lambda2 = mu^2 = 1.00e-02  (must equal mu^2 for v=1)
mu      = 0.1
lambda1 = 0.1616034235
lambda2 = 0.7580171173
