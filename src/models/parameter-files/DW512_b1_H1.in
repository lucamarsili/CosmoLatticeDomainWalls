
#Output
outputfile = /mt/user-batch/dpasari/results_z3_b_1_H1/

#Evolution
expansion = true
evolver = LF
#Lattice
N = 512
dt = 0.01
lSide = 100

#Times
t0=0
tOutputFreq = 0.1
tOutputInfreq = 5
tOutputRareFreq = 3
tMax = 80  #should start breaking from 24

#Spectra options
PS_type = 1
PS_version = 1

#GWs
GWprojectorType = 2
withGWs = false
#spectraverbosity=2
#print_header = true

fixedBackground = true
omegaEoS = 0.3333
H0 = 1 #GeV

# energy_snapshot = E_S_G 
#IC
kCutOff = 1
initial_amplitudes =  0 0    # homogeneous amplitudes in GeV
initial_momenta = 0 0    # homogeneous amplitudes in GeV2

#Model Parameters
lambda1 = 0.003
lambda2 = 0.0516398 #beta = 0.1
mu = 0.0547723
