#Output
outputfile = results/scan_z3_phys_greedy/results_DWZ3_greedy_b30p3_s02/

#Evolution
expansion = true
evolver = LF

#Lattice
N = 1024
dt = 0.029410
lSide = 150.58     # mu=0.07: cells/wall = delta_adj/(mu*a*dx); =2 at a_max, >=2 horizons/side

#Times
t0 = 0
tOutputFreq  = 0.1
tOutputInfreq  = 5
tOutputRareFreq = 3
tMax = 74.29      # a=1+eta; a_max=75.3
tBackupFreq = -1.00     # <0 = OFF (default); runs fit <72h at rec. ranks. BACKUP_FRAC to enable.

#Spectra options
PS_type = 1
PS_version = 1

#GWs
GWprojectorType = 2
withGWs = false

fixedBackground = true
omegaEoS = 0.3333
H0 = 0.07          # H0/mu = 1 -> a = 1+eta

#IC
kCutOff = 3
baseSeed = greedy_s02
initial_amplitudes = 0 0
initial_momenta    = 0 0

# Z3 domain wall, beta_N = 0.3 (R=sqrt((1-bN)/(1+bN))), lambda1=1/R, lambda2=sqrt(2)(1-R)/(3R)
mu      = 0.07
lambda1 = 1.3627702877
lambda2 = 0.1710115536

# GREEDY N=1024 plateau scan (2026-06-26). PHYSICAL. A=scal/(2aH); scal1=last col; wall_diagnostics emitted.
prsWall = false
