
#Output
outputfile = ./

#Evolution
expansion = true
evolver = LF
#Lattice
N =2048
dt = 0.01
lSide = 136

#Times
t0=0
tOutputFreq = 0.1
tOutputInfreq = 5
tOutputRareFreq = 5
tMax = 40  #should start breaking from 24

#Spectra options
PS_type = 1
PS_version = 1

#GWs
GWprojectorType = 2
withGWs = false
#spectraverbosity=2
#print_header = true

fixedBackground = true
omegaEoS = 0.3333
H0 = 0.0547723 #GeV

 
#IC
kCutOff = 3
initial_amplitudes =  0 0    # homogeneous amplitudes in GeV
initial_momenta = 0 0    # homogeneous amplitudes in GeV2

#Model Parameters
lambda1 = 0.003
lambda2 = 0.0516398 #beta = 1
mu =0.0547723
