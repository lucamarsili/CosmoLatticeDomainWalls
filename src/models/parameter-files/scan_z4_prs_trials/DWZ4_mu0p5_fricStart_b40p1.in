#Output
outputfile = /mt/user-batch/dpasari/scan_z4_prs_trials/results_DWZ4_mu0p5_fricStart_b40p1/

#Evolution
expansion = true
evolver = LF

#Lattice
N = 256
dt = 0.01
lSide = 179.2000     # dx = 0.7000, 2 pts/wall at a=1 (delta_min=1.4); program units, mu/H0-independent

#Times
t0 = 0
tOutputFreq  = 0.1
tOutputInfreq  = 5
tOutputRareFreq = 3
tMax = 90.0

#Spectra options
PS_type = 1
PS_version = 1

#GWs
GWprojectorType = 2
withGWs = false

fixedBackground = true
omegaEoS = 0.3333
H0 = 0.50000000   # 1.0*mu   (H0/mu = 1, so a = 1 + eta)

#IC
kCutOff = 3
initial_amplitudes = 0 0
initial_momenta    = 0 0

# Model Parameters (Z4 domain-wall), beta_4 = 0.1, v=1, mu = 0.5
# V = -mu^2|Phi|^2 + lambda1|Phi|^4 - lambda2(Phi^4+Phi*^4)
mu      = 0.5
lambda1 = 0.2777777778
lambda2 = 0.01388888889

# ---- TRIAL: post-formation friction via the NEW frictionStartA gate (mu=0.5, b4=0.1) ----
# Same large-mu run as DWZ4_mu0p5_b40p1 (resolved formation at a~1-3), but with constant friction
# Gamma=1.0 switched ON only AFTER the network has formed (frictionStartA below) and OFF at a=70.
# This is the correct way to test "does friction reach scaling faster": apply it to an ALREADY-
# FORMED network, NOT from phi=0 (early friction only delays the tachyonic roll, see memory).
# frictionStartA is PROVISIONAL: set it just above the a_break measured from DWZ4_mu0p5_b40p1.
# (a = 1 + eta here, so a=5 ~ eta=4; bump it up if mu=0.5 turns out to break later than ~a=3.)
prsWall        = false
prsDamping     = 0.0
frictionGamma  = 1.0
frictionStartA = 5.0
frictionEndA   = 70.0
prsStartA      = 0.0
