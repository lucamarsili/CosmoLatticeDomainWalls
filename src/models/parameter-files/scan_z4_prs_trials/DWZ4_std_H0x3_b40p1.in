#Output
outputfile = /mt/user-batch/dpasari/scan_z4_prs_trials/results_DWZ4_std_H0x3_b40p1/

#Evolution
expansion = true
evolver = LF

#Lattice
N = 256
dt = 0.01
lSide = 179.2000     # dx = 0.7000, 2 pts/wall at a=1 (delta_min=1.4); program units, mu/H0-independent

#Times
t0 = 0
tOutputFreq  = 0.1
tOutputInfreq  = 5
tOutputRareFreq = 3
tMax = 60.0

#Spectra options
PS_type = 1
PS_version = 1

#GWs
GWprojectorType = 2
withGWs = false

fixedBackground = true
omegaEoS = 0.3333
H0 = 0.03000000   # 3.0*mu  (H0/mu = 3, more drag)

#IC
kCutOff = 3
initial_amplitudes = 0 0
initial_momenta    = 0 0

# Model Parameters (Z4 domain-wall), beta_4 = 0.1, v=1, mu = 0.01
# V = -mu^2|Phi|^2 + lambda1|Phi|^4 - lambda2(Phi^4+Phi*^4)
mu      = 0.01
lambda1 = 0.0001111111111
lambda2 = 5.555555556e-06

# ---- TRIAL: standard EOM, H0/mu=3 -- measure breaking-a with MORE Hubble drag (user's suggestion) ----
# a = 1 + 3*eta (a_max~181 at tMax=60). Does more drag move a_break up (resolution worse) or down?
prsWall       = false
prsDamping    = 0.0
frictionGamma = 0.0
frictionEndA  = 3.0
prsStartA     = 0.0
