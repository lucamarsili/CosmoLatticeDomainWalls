#Output
outputfile = ./

#Evolution
expansion = true
evolver = LF

#Lattice
N = 512
dt = 0.02
lSide = 80

#Times
t0=0
tOutputFreq = 0.1
tOutputInfreq = 1
tOutputRareFreq = 1
tMax = 40

energy_snapshot = S_C E_S_K E_S_G E_V


#Spectra options
PS_type = 1
PS_version = 1

#GW
GWprojectorType = 2
withGWs = no
spectraverbosity=2
print_header = true

fixedBackground = true
omegaEoS = 0.333




#IC
kCutOff = 1
initial_amplitudes = 0     # homogeneous amplitudes in GeV
initial_momenta = 0     # homogeneous amplitudes in GeV2

#Model Parameters
lambda = 0.003
eta = 1

H0 = 0.0774597 #GeV 2* lambda* eta**2
