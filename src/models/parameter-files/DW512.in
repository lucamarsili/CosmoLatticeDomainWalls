#Output
outputfile = /mt/user-batch/dpasari/results_z3_b0/

#Evolution
expansion = true
evolver = VV2

#Lattice
N = 256
dt = 0.01
lSide = 34

#Times
t0=0
tOutputFreq = 0.1
tOutputInfreq = 1
tOutputRareFreq = 3
tMax = 20

#Spectra options
PS_type = 1
PS_version = 1

#GW
GWprojectorType = 2
withGWs = false
spectraverbosity=2
print_header = true

fixedBackground = true
omegaEoS = 0.3333333
H0 = 1 #GeV

# energy_snapshot = S_C

#IC
kCutOff = 1
initial_amplitudes = 0     # homogeneous amplitudes in GeV
initial_momenta = 0   # homogeneous amplitudes in GeV2

#Model Parameters
lambda = 0.5
eta = 1


